# Copy to .env and change every value before showing the system to anyone.
# docker compose reads .env automatically.

# PostgreSQL
DB_USER=dbms
DB_PASSWORD=change-me-db

# MQTT broker users (the gateway's secrets.h must use the gateway password)
MQTT_BACKEND_PASSWORD=change-me-backend
MQTT_GATEWAY_PASSWORD=change-me-gateway

# Shared token the gateway checks on every remote command (GW_CMD_TOKEN in secrets.h)
GATEWAY_COMMAND_TOKEN=change-me-token

# JWT signing key, at least 32 characters
JWT_SECRET=replace-with-a-long-random-string-of-48-characters

# Dashboard accounts created on first start
BMS_ADMIN_USERNAME=admin
BMS_ADMIN_PASSWORD=change-me-admin
BMS_VIEWER_USERNAME=viewer
BMS_VIEWER_PASSWORD=change-me-viewer

# Simulator (docker compose --profile sim up): rest | cycle
SIM_PROFILE=cycle
# SIM_DEVICE_ID=sim-01
# SIM_UNTAGGED=1                       # publish without the "simulated" tag
# SIM_NTC_OFFSETS=-0.1,-7.8,-3.2,-17.1 # per-NTC reading error in C
